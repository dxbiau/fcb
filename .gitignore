# ═══════════════════════════════════════════════════
# FCB Bot — Git Ignore
# Updated 2026-02-21 after workspace reorganization
# ═══════════════════════════════════════════════════

# ─── SECRETS (NEVER commit) ───
.env
.env.*
!.env.example

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# ─── Data (hundreds of MB of candle CSVs) ───
data/
results/
old_cache/

# ─── Organized research scripts (moved from root) ───
scripts/

# ─── Archive (old state backups, output logs, deploys) ───
archive/

# ─── Framework modules (not needed for live deploy) ───
analysis/
backtest/
strategy/
tests/
config/

# ─── Build / Packaging ───
pyproject.toml
setup.cfg
MANIFEST.in
*.tar.gz
*.zip

# ─── Backtest config at root (not live config) ───
/config.py

# ─── Runtime state (created/modified at runtime) ───
live/state.json
live/growth_state.json
live/trades.csv
live/bot.lock
live/logs/
live/skipped_trades.csv

# ─── IDE / OS ───
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Temp files ───
/_*.py
*.tmp
