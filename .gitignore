# ─── SECRETS (NEVER commit) ───
.env
.env.*
!.env.example

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# ─── Data (hundreds of MB) ───
data/
results/
old_cache/

